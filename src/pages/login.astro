---
import AuthForm from '@/components/AuthForm.astro'

// Si ya está autenticado, redirige a dashboard
const session = Astro.cookies.get('sb-auth-token')
if (session) {
  return Astro.redirect('/dashboard')
}
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Iniciar Sesión | Generador de Contraseñas</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
      background: #3a7f7e;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
    }
  </style>
</head>
<body>
  <AuthForm type="login" />
</body>
</html>
