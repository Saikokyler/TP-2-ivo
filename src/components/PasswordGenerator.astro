---
// Componente de generador de contraseñas
---

<div class="generator-container">
  <div class="generator-card">
    <h2>🔐 Generador de Contraseñas</h2>
    <p class="subtitle">Genera contraseñas aleatorias de 8 dígitos</p>

    <div class="password-display">
      <input 
        type="text" 
        id="password-input" 
        readonly 
        placeholder="Haz click en Generar"
        class="password-input"
      />
      <button id="copy-btn" class="copy-btn" type="button">
        📋 Copiar
      </button>
    </div>

    <div class="button-group">
      <button id="generate-btn" class="btn btn-primary" type="button">
        ⚡ Generar Contraseña
      </button>
      <button id="save-btn" class="btn btn-success" type="button" disabled>
        💾 Guardar
      </button>
    </div>

    <div id="message" class="message"></div>
  </div>

  <div class="history-section">
    <h3>📜 Historial de Contraseñas</h3>
    <div id="password-list" class="password-list">
      <p class="loading">Cargando contraseñas...</p>
    </div>
  </div>
</div>

<script>
  // Funciones inline
  function generatePassword() {
    let password = ''
    for (let i = 0; i < 8; i++) {
      password += Math.floor(Math.random() * 10)
    }
    return password
  }

  function formatDate(date) {
    const d = new Date(date)
    return d.toLocaleDateString('es-ES', {
      year: 'numeric',
      month: 'long',
      day: 'numeric',
      hour: '2-digit',
      minute: '2-digit'
    })
  }

  async function copyToClipboard(text) {
    try {
      await navigator.clipboard.writeText(text)
      return true
    } catch (err) {
      return false
    }
  }

  async function savePassword(passwordValue) {
    try {
      const response = await fetch('/api/passwords/save', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ password_value: passwordValue })
      })
      const result = await response.json()
      return { success: response.ok, error: result.error || null }
    } catch (error) {
      return { success: false, error: error.message }
    }
  }

  async function getPasswords() {
    try {
      const response = await fetch('/api/passwords/list')
      if (!response.ok) throw new Error('Error obteniendo contraseñas')
      const data = await response.json()
      return { success: true, data: data.passwords || [] }
    } catch (error) {
      return { success: false, error: error.message }
    }
  }

  async function deletePassword(id) {
    try {
      const response = await fetch('/api/passwords/delete', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ id })
      })
      return { success: response.ok }
    } catch (error) {
      return { success: false, error: error.message }
    }
  }

  // Event listeners
  const generateBtn = document.getElementById('generate-btn')
  const saveBtn = document.getElementById('save-btn')
  const copyBtn = document.getElementById('copy-btn')
  const passwordInput = document.getElementById('password-input')
  const messageDiv = document.getElementById('message')
  const passwordList = document.getElementById('password-list')

  let currentPassword = ''

  if (generateBtn) {
    generateBtn.addEventListener('click', () => {
      currentPassword = generatePassword()
      passwordInput.value = currentPassword
      saveBtn.disabled = false
      messageDiv.textContent = ''
      messageDiv.className = 'message'
    })
  }

  if (saveBtn) {
    saveBtn.addEventListener('click', async () => {
      if (!currentPassword) return

      saveBtn.disabled = true
      const result = await savePassword(currentPassword)

      if (result.success) {
        messageDiv.textContent = '✅ Contraseña guardada'
        messageDiv.className = 'message success'
        passwordInput.value = ''
        currentPassword = ''
        saveBtn.disabled = true
        loadPasswords()
        setTimeout(() => {
          messageDiv.textContent = ''
        }, 2000)
      } else {
        messageDiv.textContent = '❌ Error: ' + result.error
        messageDiv.className = 'message error'
        saveBtn.disabled = false
      }
    })
  }

  if (copyBtn) {
    copyBtn.addEventListener('click', async () => {
      if (!passwordInput.value) return

      const success = await copyToClipboard(passwordInput.value)
      if (success) {
        messageDiv.textContent = '✅ Copiada al portapapeles'
        messageDiv.className = 'message success'
        setTimeout(() => {
          messageDiv.textContent = ''
        }, 1500)
      }
    })
  }

  async function loadPasswords() {
    const result = await getPasswords()

    if (!result.success) {
      passwordList.innerHTML = '<p class="error">Error cargando contraseñas</p>'
      return
    }

    const passwords = result.data

    if (passwords.length === 0) {
      passwordList.innerHTML = '<p class="empty">No hay contraseñas guardadas</p>'
      return
    }

    passwordList.innerHTML = passwords
      .map(
        (p) => `
        <div class="password-item">
          <div class="password-content">
            <span class="password-value">${p.password_value}</span>
            <span class="password-date">${formatDate(p.created_at)}</span>
          </div>
          <div class="password-actions">
            <button class="action-btn copy-item" data-value="${p.password_value}" type="button">
              📋
            </button>
            <button class="action-btn delete-item" data-id="${p.id}" type="button">
              🗑️
            </button>
          </div>
        </div>
      `
      )
      .join('')

    document.querySelectorAll('.copy-item').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const value = btn.getAttribute('data-value')
        const success = await copyToClipboard(value)
        if (success) {
          messageDiv.textContent = '✅ Copiada'
          messageDiv.className = 'message success'
          setTimeout(() => {
            messageDiv.textContent = ''
          }, 1500)
        }
      })
    })

    document.querySelectorAll('.delete-item').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const id = btn.getAttribute('data-id')
        if (confirm('¿Eliminar esta contraseña?')) {
          const result = await deletePassword(id)
          if (result.success) {
            loadPasswords()
          }
        }
      })
    })
  }

  loadPasswords()
</script>

<style>
  .generator-container {
    max-width: 1000px;
    margin: 2rem auto;
    padding: 0 1rem;
  }

  .generator-card {
    background: white;
    border-radius: 8px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    padding: 2rem;
    margin-bottom: 2rem;
  }

  h2 {
    color: #333;
    margin-bottom: 0.5rem;
  }

  .subtitle {
    color: #999;
    margin-bottom: 1.5rem;
  }

  .password-display {
    display: flex;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .password-input {
    flex: 1;
    padding: 0.75rem;
    border: 2px solid #ddd;
    border-radius: 4px;
    font-size: 1.2rem;
    font-weight: bold;
    text-align: center;
    font-family: 'Courier New', monospace;
  }

  .password-input:focus {
    outline: none;
    border-color: #007bff;
  }

  .copy-btn {
    padding: 0.75rem 1rem;
    background: #6c757d;
    color: white;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    font-weight: 600;
    transition: background 0.2s;
  }

  .copy-btn:hover {
    background: #545b62;
  }

  .button-group {
    display: flex;
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .button-group button {
    flex: 1;
  }

  .btn {
    padding: 0.75rem 1.5rem;
    border: none;
    border-radius: 4px;
    font-size: 1rem;
    cursor: pointer;
    font-weight: 600;
    transition: all 0.2s ease;
  }

  .btn:disabled {
    opacity: 0.6;
    cursor: not-allowed;
  }

  .btn-primary {
    background: #007bff;
    color: white;
  }

  .btn-primary:hover:not(:disabled) {
    background: #0056b3;
  }

  .btn-success {
    background: #28a745;
    color: white;
  }

  .btn-success:hover:not(:disabled) {
    background: #218838;
  }

  .message {
    text-align: center;
    padding: 0.75rem;
    border-radius: 4px;
    margin-top: 1rem;
    min-height: 1.5rem;
  }

  .message.success {
    background: #d4edda;
    color: #155724;
  }

  .message.error {
    background: #f8d7da;
    color: #721c24;
  }

  .history-section {
    background: white;
    border-radius: 8px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    padding: 2rem;
  }

  h3 {
    color: #333;
    margin-bottom: 1.5rem;
  }

  .password-list {
    max-height: 500px;
    overflow-y: auto;
  }

  .password-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem;
    border-bottom: 1px solid #eee;
    transition: background 0.2s;
  }

  .password-item:hover {
    background: #f9f9f9;
  }

  .password-content {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
  }

  .password-value {
    font-size: 1.2rem;
    font-weight: bold;
    font-family: 'Courier New', monospace;
    color: #333;
  }

  .password-date {
    font-size: 0.85rem;
    color: #999;
  }

  .password-actions {
    display: flex;
    gap: 0.5rem;
  }

  .action-btn {
    padding: 0.5rem 0.75rem;
    background: #e9ecef;
    border: none;
    border-radius: 4px;
    cursor: pointer;
    font-size: 1rem;
    transition: background 0.2s;
  }

  .action-btn:hover {
    background: #dee2e6;
  }

  .loading,
  .empty,
  .error {
    text-align: center;
    color: #999;
    padding: 2rem 1rem;
  }

  .error {
    color: #dc3545;
  }
</style>
