---
// Persistent background music player component
// Audio file should be at /public/music/[SONG_NAME].mp3
---

<div class="music-player-container">
  <div class="music-player">
    <button class="player-btn play-pause-btn" title="Play/Pause" aria-label="Play/Pause">
      ▶
    </button>
    
    <div class="player-info">
      <p class="song-label">Background Music</p>
    </div>

    <div class="player-controls">
      <button class="player-btn mute-btn" title="Mute/Unmute" aria-label="Mute">
        🔊
      </button>
      <input type="range" class="volume-slider" min="0" max="100" value="30" title="Volume" />
    </div>
  </div>

  <audio id="bg-music" preload="none" loop>
    <source src="/music/ill-wait-and-pray.mp3" type="audio/mpeg" />
  </audio>
</div>

<style>
  .music-player-container {
    position: fixed;
    bottom: 20px;
    right: 20px;
    z-index: 999;
  }

  .music-player {
    display: flex;
    align-items: center;
    gap: 10px;
    background: rgba(26, 26, 26, 0.95);
    border: 2px solid rgba(58, 127, 126, 0.5);
    border-radius: 12px;
    padding: 12px 16px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(10px);
    animation: slideInUp 0.4s ease-out;
  }

  @keyframes slideInUp {
    from {
      transform: translateY(120px);
      opacity: 0;
    }
    to {
      transform: translateY(0);
      opacity: 1;
    }
  }

  .player-btn {
    background: rgba(58, 127, 126, 0.8);
    border: none;
    color: white;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    cursor: pointer;
    font-size: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
    flex-shrink: 0;
  }

  .player-btn:hover {
    background: rgba(58, 127, 126, 1);
    transform: scale(1.05);
  }

  .player-btn:active {
    transform: scale(0.95);
  }

  .play-pause-btn {
    width: 40px;
    height: 40px;
    font-size: 18px;
  }

  .mute-btn {
    width: 32px;
    height: 32px;
    font-size: 14px;
  }

  .player-info {
    min-width: 150px;
    text-align: left;
  }

  .song-label {
    color: rgba(255, 255, 255, 0.9);
    font-size: 12px;
    font-weight: 500;
    margin: 0;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .player-controls {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }

  .volume-slider {
    width: 80px;
    height: 4px;
    border-radius: 2px;
    background: rgba(255, 255, 255, 0.2);
    outline: none;
    -webkit-appearance: none;
    appearance: none;
    cursor: pointer;
  }

  .volume-slider::-webkit-slider-thumb {
    -webkit-appearance: none;
    appearance: none;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: rgba(58, 127, 126, 1);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .volume-slider::-webkit-slider-thumb:hover {
    transform: scale(1.3);
    background: rgba(100, 180, 178, 1);
  }

  .volume-slider::-moz-range-thumb {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: rgba(58, 127, 126, 1);
    cursor: pointer;
    border: none;
    transition: all 0.2s ease;
  }

  .volume-slider::-moz-range-thumb:hover {
    transform: scale(1.3);
    background: rgba(100, 180, 178, 1);
  }

  .volume-slider::-moz-range-track {
    background: transparent;
    border: none;
  }

  .volume-slider::-moz-range-progress {
    background: rgba(58, 127, 126, 0.6);
    height: 4px;
    border-radius: 2px;
  }

  /* Responsive: stack vertically on mobile */
  @media (max-width: 480px) {
    .music-player {
      flex-direction: column;
      gap: 8px;
      padding: 10px 12px;
      width: calc(100vw - 40px);
      max-width: 280px;
    }

    .player-info {
      min-width: auto;
      width: 100%;
    }

    .player-controls {
      width: 100%;
      justify-content: center;
    }

    .volume-slider {
      flex: 1;
      max-width: 100px;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const audio = document.getElementById('bg-music') as HTMLAudioElement;
    const playPauseBtn = document.querySelector('.play-pause-btn') as HTMLButtonElement;
    const muteBtn = document.querySelector('.mute-btn') as HTMLButtonElement;
    const volumeSlider = document.querySelector('.volume-slider') as HTMLInputElement;

    if (!audio || !playPauseBtn || !muteBtn || !volumeSlider) {
      console.warn('Music player elements not found');
      return;
    }

    let hasInteracted = false;
    let isMuted = false;
    const initialVolume = 0.3; // 30%

    // Set initial volume
    audio.volume = initialVolume;
    volumeSlider.value = String(initialVolume * 100);

    // Handle first user interaction to start autoplay
    const startMusic = () => {
      if (!hasInteracted) {
        hasInteracted = true;
        audio.play().catch((err) => {
          console.warn('Autoplay failed:', err);
        });
        playPauseBtn.textContent = '⏸';
        document.removeEventListener('click', startMusic);
        document.removeEventListener('touchstart', startMusic);
        document.removeEventListener('keydown', startMusic);
      }
    };

    document.addEventListener('click', startMusic);
    document.addEventListener('touchstart', startMusic);
    document.addEventListener('keydown', startMusic);

    // Play/Pause button
    playPauseBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      if (audio.paused) {
        audio.play();
        playPauseBtn.textContent = '⏸';
      } else {
        audio.pause();
        playPauseBtn.textContent = '▶';
      }
    });

    // Mute button
    muteBtn.addEventListener('click', (e) => {
      e.stopPropagation();
      isMuted = !isMuted;
      audio.muted = isMuted;
      muteBtn.textContent = isMuted ? '🔇' : '🔊';
    });

    // Volume slider
    volumeSlider.addEventListener('input', (e) => {
      e.stopPropagation();
      const value = parseInt((e.target as HTMLInputElement).value) / 100;
      audio.volume = Math.max(0, Math.min(1, value));
    });

    // Update play/pause button when audio ends or changes state
    audio.addEventListener('play', () => {
      playPauseBtn.textContent = '⏸';
    });

    audio.addEventListener('pause', () => {
      playPauseBtn.textContent = '▶';
    });

    // Handle page visibility to pause/resume (optional for better UX)
    document.addEventListener('visibilitychange', () => {
      if (document.hidden && !audio.paused) {
        audio.pause();
      } else if (!document.hidden && hasInteracted && !isMuted) {
        audio.play().catch((err) => {
          console.warn('Resume autoplay failed:', err);
        });
      }
    });
  });
</script>
